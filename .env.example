# Read-only MongoDB user — used for all GET operations
MONGODB_URI=mongodb+srv://readonly-user:password@cluster.mongodb.net/vermo-production
# Write-enabled MongoDB user — used only for edit/delete operations in elevated mode
# If omitted, write operations fall back to MONGODB_URI (suitable for development)
MONGODB_WRITE_URI=mongodb+srv://write-user:password@cluster.mongodb.net/vermo-production
MONGODB_DB=vermo-production
JWT_SECRET=replace-with-a-long-random-secret
PORT=3001
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Evolution API — self-hosted WhatsApp REST API
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_GROUP_ID=
WHATSAPP_CHANNEL_ID=
