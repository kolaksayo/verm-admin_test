# Read-only MongoDB user — used for all GET operations
MONGODB_URI=mongodb+srv://readonly-user:password@cluster.mongodb.net/vermo-production
# Write-enabled MongoDB user — used only for edit/delete operations in elevated mode
# If omitted, write operations fall back to MONGODB_URI (suitable for development)
MONGODB_WRITE_URI=mongodb+srv://write-user:password@cluster.mongodb.net/vermo-production
MONGODB_DB=vermo-production
JWT_SECRET=replace-with-a-long-random-secret
PORT=3001
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# whapi.cloud — Bearer token for group/channel/DM messages
WHATSAPP_API_TOKEN=
# Interakt.ai — Basic API key used ONLY for the approved welcome message template
WHATSAPP_API_KEY=
# Interakt.ai template name as registered in WhatsApp Business Manager
WHATSAPP_INTERAKT_TEMPLATE=welcome_to_vermosports
WHATSAPP_GROUP_ID=
WHATSAPP_CHANNEL_ID=
